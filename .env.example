# Public HTTPS base URL Vapi can reach (ngrok / Fly / Render URL).
PUBLIC_URL=https://your-app.example.com

# --- Webhook auth (set at least one; requests are rejected otherwise) ---
# Shared secret, accepted as `X-Vapi-Secret: <secret>` or `Authorization: Bearer <secret>`.
VAPI_WEBHOOK_SECRET=change-me
# Optional HMAC-SHA256 over the raw body (hex, `sha256=` prefix allowed).
VAPI_HMAC_SECRET=
VAPI_HMAC_HEADER=x-vapi-signature
# Only for local experiments. Never in production.
ALLOW_UNAUTHENTICATED=false

DB_PATH=data/voice_agent.db

# --- Who may use agentic (side-effecting / private) tools ---
ALLOWED_CALLERS=+15551234567
ALLOW_WEB_AGENTIC=false
RATE_LIMIT_PER_MINUTE=20
# Cached lookups (weather, search, news, Wikipedia, convert) slower than this reply with a
# holding line and finish in the background; the retry is served from cache. 0 disables.
TOOL_SOFT_DEADLINE_S=1.5
DEEP_TASKS_PER_HOUR=3

# --- Claude (tool reasoning + deep tasks) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACK_MODEL=claude-opus-5

# --- Vapi ---
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Optional Vapi credential (Bearer/HMAC) used instead of sending the secret as a header.
VAPI_CREDENTIAL_ID=
VAPI_LLM_PROVIDER=anthropic
VAPI_LLM_MODEL=claude-sonnet-5
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
OWNER_NAME=Sam
# Allowlisted callers can ask to be transferred here (E.164). Leave empty to disable transfers.
TRANSFER_NUMBER=
# IANA zone for the date/time in the prompt and calendar comparisons.
TIMEZONE=America/Los_Angeles
OWNER_EMAIL=you@example.com

# --- Admin dashboard at /admin (HTTP Basic). Off while ADMIN_PASSWORD is empty. ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Follow-ups (dry-run unless DRY_RUN=false and the channel is configured) ---
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
